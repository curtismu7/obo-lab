# jev-lab reads no per-app settings file. Port and bind come from the shell.
PORT=7550            # allowed range 7550-7559
# JEVL_BIND=0.0.0.0  # opt-in only; Docker sets this itself
#
# Real mode (rule 19) is configured from the ONE shared settings file ~/Development/.env, not here:
#   OPENROUTER_API_KEY=...   (or JEV_ENDPOINT=http://host:port/v1/systemone for a local model)
#   JEV_MODEL=typesafe/jev-1.13
# With neither set the Real button is disabled with a how-to tooltip and Mock answers everything.
