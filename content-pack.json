  "glossary": [
    {
      "id": "obo",
      "term": "On-behalf-of (OBO)",
      "definition": "An agent acts for a signed-in person: the person's identity is kept (sub), the agent is recorded (act), and everything else narrows. Delegation, not impersonation."
    },
    {
      "id": "act",
      "term": "act claim",
      "definition": "RFC 8693: names the client that actually performed the exchange on the subject's behalf. The downstream requires it; a token without act is a person token, not a delegation."
    },
    {
      "id": "subject-token",
      "term": "Subject token",
      "definition": "The signed-in person's access token, used as the subject_token in the exchange. The agent never receives it."
    },
    {
      "id": "actor-token",
      "term": "Actor token",
      "definition": "The agent's own client-credentials token, used as the actor_token. It proves who the agent is without borrowing the person's identity."
    },
    {
      "id": "delegation",
      "term": "Delegation vs impersonation",
      "definition": "Impersonation would change sub. Delegation keeps sub and adds act: every downstream call can say who the person is AND which agent acted."
    },
    {
      "id": "narrowing",
      "term": "Scope narrowing",
      "definition": "The delegated token carries only the scopes the task needs, never the person's full set. The exchange cannot widen scope."
    },
    {
      "id": "leak-scan",
      "term": "Leak scan",
      "definition": "Everything a page would hand to a model is scanned for token text. Tokens live between the app, the issuer and the API; the model reasons on results only."
    }
  ],
